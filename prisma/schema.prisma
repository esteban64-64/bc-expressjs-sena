// Prisma Schema — Semana 05 (SENA Centro de Formación)
// Recurso principal: Apprentice (aprendiz) — expuesto en /api/v1/apprentices
// Recurso secundario: Program (programa) — relación 1:N con Apprentice

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Program {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @unique
  nivel         String
  duracionMeses Int
  apprentices   Apprentice[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("programs")
}

model Apprentice {
  id                String   @id @default(uuid()) @db.Uuid
  nombreCompleto    String
  documento         String   @unique
  ficha             String
  estado            String
  fechaIngreso      DateTime
  promedioAcumulado Float
  costoMatricula    Float
  programId         String   @db.Uuid
  program           Program  @relation(fields: [programId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("apprentices")
}
