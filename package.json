{
  "name": "semana09-sena-testing",
  "version": "1.0.0",
  "description": "Semana 09 - Testing de la API con Jest y Supertest (SENA Centro de Formación)",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx src/servidor.ts",
    "build": "tsc --noEmit",
    "start": "node dist/src/servidor.js",
    "seed": "tsx src/semilla.ts",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "mongoose": "9.4.1",
    "express": "5.2.1",
    "cors": "2.8.6",
    "morgan": "1.11.0",
    "winston": "3.19.0",
    "zod": "3.25.76",
    "dotenv": "16.4.7",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "jsonwebtoken": "9.0.2",
    "helmet": "8.1.0",
    "express-rate-limit": "8.2.1",
    "express-mongo-sanitize": "2.2.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "22.20.1",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/jsonwebtoken": "9.0.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.5",
    "supertest": "7.1.4",
    "@types/jest": "29.5.14",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.2.3"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": ["bcrypt", "mongodb-memory-server"]
  }
}
