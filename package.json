{
  "name": "semana05-sena-postgresql-prisma",
  "version": "1.0.0",
  "description": "Semana 05 - API con PostgreSQL y Prisma ORM (SENA Centro de Formación)",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx src/servidor.ts",
    "build": "tsc --noEmit",
    "start": "node dist/src/servidor.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "express": "5.2.1",
    "cors": "2.8.6",
    "morgan": "1.11.0",
    "winston": "3.19.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "22.20.1",
    "prisma": "6.8.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
